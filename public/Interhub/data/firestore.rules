// ============================================
// Firestore Security Rules — InternHub (v2, khớp SCHEMA_FIRESTORE.md)
// Quy tắc nghiệp vụ (độ dài ghi chú, điểm, thời hạn 5 ngày) kiểm tra ở trình duyệt (phương án b).
// Rules chỉ kiểm soát ai được đọc/ghi collection nào và các trường nào.
// ============================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hàm dùng chung ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Admin kỹ thuật: đúng email đã xác minh (không phụ thuộc document users)
    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'dptbinh193@gmail.com';
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUser() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function approved() {
      return hasUser() && me().status == 'approved' && me().get('isActive', false) == true;
    }

    // Quản trị: Admin kỹ thuật, hoặc tài khoản được Admin cấp cờ adminGranted (Phòng Nhân sự được giao quyền)
    function isAdmin() {
      return isSuperAdmin() || (approved() && me().get('adminGranted', false) == true);
    }

    function isHR() {
      return approved() && me().role == 'hr';
    }

    function isHRorAdmin() {
      return isAdmin() || isHR();
    }

    function isSupervisor() {
      return approved() && me().role == 'supervisor';
    }

    function isMentor() {
      return approved() && me().role == 'mentor';
    }

    function isCommittee() {
      return approved() && me().role == 'committee';
    }

    function myDept() {
      return me().get('department', '');
    }

    // Các trường được phép đổi trong một lần cập nhật
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Trạng thái cho phép người hướng dẫn / TBP tự đánh giá sửa điểm
    function editableStatus(s) {
      return s in ['chua_bat_dau', 'dang_thuc_hien', 'tra_ve'];
    }

    // ============================================
    // users — tài khoản và vai trò
    // ============================================
    match /users/{uid} {
      // Chính người dùng, Admin, và TBP/HR (để chọn người hướng dẫn trong bộ phận)
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        isHR() ||
        isSupervisor()
      );

      // Đăng ký mới: chỉ tạo hồ sơ của chính mình, trạng thái chờ duyệt, không có vai trò
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && (!('role' in request.resource.data) || request.resource.data.role == null)
        && !('adminGranted' in request.resource.data);

      // Người dùng chỉ được sửa tên hiển thị và thời gian đăng nhập của mình
      allow update: if signedIn()
        && request.auth.uid == uid
        && changedKeys().hasOnly(['fullName', 'lastLogin']);

      // Duyệt tài khoản, gán vai trò và bộ phận: Admin
      // Chỉ Admin kỹ thuật được cấp/thu quyền adminGranted, đổi email hoặc vai trò quản trị
      allow update: if isSuperAdmin();
      allow update: if isAdmin()
        && !changedKeys().hasAny(['adminGranted', 'email', 'uid']);

      allow delete: if isSuperAdmin();
    }

    // ============================================
    // departments — danh mục bộ phận
    // ============================================
    match /departments/{code} {
      allow read: if isAdmin() || approved();
      allow write: if isHRorAdmin();
    }

    // ============================================
    // periods — kỳ đánh giá
    // ============================================
    match /periods/{periodId} {
      allow read: if isAdmin() || approved();
      allow write: if isHRorAdmin();
    }

    // ============================================
    // school_committees — Tổ CTSV phụ trách từng trường
    // ============================================
    match /school_committees/{school} {
      allow read: if isAdmin() || approved();
      allow write: if isHRorAdmin();
    }

    // ============================================
    // interns — thực tập sinh
    // ============================================
    match /interns/{internId} {
      allow read: if isHRorAdmin()
        || (isSupervisor() && resource.data.department == myDept())
        || (isMentor() && resource.data.evaluatorUid == request.auth.uid);

      // HR/Admin quản lý hồ sơ SVTT
      allow create, delete: if isHRorAdmin();
      allow update: if isHRorAdmin();

      // Người hướng dẫn: chỉ cập nhật chấm công của SVTT được giao cho mình
      allow update: if isMentor()
        && resource.data.evaluatorUid == request.auth.uid
        && changedKeys().hasOnly(['attendance', 'updatedAt']);

      // TBP tự đánh giá SVTT của bộ phận mình (không áp dụng cho PNS): chỉ chấm công
      allow update: if isSupervisor()
        && resource.data.department == myDept()
        && myDept() != 'PNS'
        && resource.data.get('evaluatorUid', null) == null
        && resource.data.get('evaluatorAssigned', false) == true
        && changedKeys().hasOnly(['attendance', 'updatedAt']);
    }

    // ============================================
    // tickets — phiếu đánh giá (id = periodId-internId)
    // ============================================
    match /tickets/{ticketId} {
      // Đọc
      allow read: if isHRorAdmin()
        || (isMentor() && resource.data.evaluatorUid == request.auth.uid)
        || (isCommittee() && resource.data.committeeUid == request.auth.uid)
        || (isSupervisor() && resource.data.department == myDept() && (
              resource.data.status == 'cho_truong_bo_phan'
              || (resource.data.get('evaluatorUid', null) == null && resource.data.get('evaluatorAssigned', false) == true)
            ));

      // Tạo phiếu: khi mở kỳ (HR/Admin)
      allow create: if isHRorAdmin();

      // HR/Admin: phân công, mở lại, xóa
      allow update: if isHRorAdmin();
      allow delete: if isAdmin();

      // Người hướng dẫn: chấm, nhận xét, gửi phê duyệt phiếu của mình
      allow update: if isMentor()
        && resource.data.evaluatorUid == request.auth.uid
        && editableStatus(resource.data.status)
        && changedKeys().hasOnly(['scores', 'strengths', 'improvements', 'status', 'sendCount', 'returnReason', 'history', 'updatedAt'])
        && request.resource.data.status in ['dang_thuc_hien', 'cho_truong_bo_phan'];

      // TBP duyệt hoặc trả về phiếu người hướng dẫn gửi lên
      allow update: if isSupervisor()
        && resource.data.department == myDept()
        && resource.data.status == 'cho_truong_bo_phan'
        && changedKeys().hasOnly(['status', 'sendCount', 'returnReason', 'history', 'updatedAt'])
        && request.resource.data.status in ['cho_to_cong_tac', 'tra_ve'];

      // TBP tự đánh giá SVTT của bộ phận (không áp dụng cho PNS)
      allow update: if isSupervisor()
        && resource.data.department == myDept()
        && myDept() != 'PNS'
        && resource.data.get('evaluatorUid', null) == null
        && resource.data.get('evaluatorAssigned', false) == true
        && editableStatus(resource.data.status)
        && changedKeys().hasOnly(['scores', 'strengths', 'improvements', 'status', 'sendCount', 'returnReason', 'history', 'updatedAt'])
        && request.resource.data.status in ['dang_thuc_hien', 'cho_to_cong_tac'];

      // Tổ CTSV: nhập hai ô điểm, lý do, và chốt (khi phiếu đang ở bước Tổ)
      allow update: if isCommittee()
        && resource.data.committeeUid == request.auth.uid
        && resource.data.status == 'cho_to_cong_tac'
        && changedKeys().hasOnly(['committeeParts', 'committeeScore', 'committeeReason', 'status', 'history', 'updatedAt'])
        && request.resource.data.status in ['cho_to_cong_tac', 'da_chot'];
    }
  }
}
